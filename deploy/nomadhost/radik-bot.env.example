# Copy to /etc/radik-bot/radik-bot.env and fill in secrets on the VPS.
# Never commit the filled-in env file or send secrets in chat.

POCKET_SSID=
POCKET_DEMO=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLIC_BASE_URL=https://bot.example.com

API_PORT=8765
TELEGRAM_BRIDGE_PORT=8010
TELEGRAM_BRIDGE_URL=http://127.0.0.1:8010
RADIK_SIGNAL_STATE_FILE=/var/lib/radik-bot/signal-state.json

MIN_PAYOUT=92
SIGNAL_TIMEZONE=Europe/Kyiv
SIGNAL_START_HOUR=09:00
SIGNAL_END_HOUR=23:00
SIGNAL_DURATION_SEC=120
SIGNAL_SEARCH_TIMEOUT_SEC=180
SIGNAL_RETRY_DELAY_SEC=300
SIGNAL_SCAN_PAIRS=1
SIGNAL_ENTRY_NOTICE_SEC=15
PRICE_RETRY_TIMEOUT_SEC=15
GEMINI_MIN_REQUEST_INTERVAL_SEC=15
CANDLE_FETCH_TIMEOUT_SEC=12
MAX_OVERLAYS=2
MARKET_PAUSE_SEC=1200
STARTUP_SAFETY_PAUSE_SEC=0
MARKET_MONITOR_INTERVAL_SEC=60
MARKET_MONITOR_PAIRS=3
MARKET_RECOVERY_REQUIRED_PAIRS=2
MARKET_RECOVERY_VOLATILITY_MULTIPLIER=1.25
MARKET_RECOVERY_MIN_MOVE_PCT=0.015