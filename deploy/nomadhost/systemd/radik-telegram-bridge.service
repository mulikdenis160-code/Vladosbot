[Unit]
Description=RADIK AI BOT Telegram bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radikbot
Group=radikbot
WorkingDirectory=/opt/radik-bot
EnvironmentFile=/etc/radik-bot/radik-bot.env
ExecStart=/usr/bin/node /opt/radik-bot/bot/telegram_bridge.mjs
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target