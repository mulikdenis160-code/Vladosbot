modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RADIK AI BOT"

[[workflows.workflow]]
name = "RADIK AI BOT"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "TELEGRAM_BRIDGE_PORT=8010 node bot/telegram_bridge.mjs & API_PORT=8008 uv run python bot/radik_bot.py"
waitForPort = 8008

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
MAX_OVERLAYS = "2"
SIGNAL_DURATION_SEC = "120"
SIGNAL_END_HOUR = "23:00"
SIGNAL_START_HOUR = "09:00"
SIGNAL_TIMEZONE = "Europe/Kyiv"
TELEGRAM_BRIDGE_URL = "http://127.0.0.1:8010"
TELEGRAM_CHAT_ID = "-1004352240671"
