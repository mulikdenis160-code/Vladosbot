modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "vm"
run = "TELEGRAM_BRIDGE_PORT=8010 node bot/telegram_bridge.mjs & API_PORT=8008 uv run python bot/radik_bot.py"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
MAX_OVERLAYS = "3"
SIGNAL_DURATION_SEC = "300"
SIGNAL_ENTRY_NOTICE_SEC = "15"
SIGNAL_RETRY_DELAY_SEC = "180"
CANDLE_FETCH_TIMEOUT_SEC = "12"
PRICE_RETRY_TIMEOUT_SEC = "15"
SIGNAL_END_HOUR = "18:30"
SIGNAL_START_HOUR = "16:30"
SIGNAL_TIMEZONE = "Europe/Kyiv"
TELEGRAM_BRIDGE_URL = "http://127.0.0.1:8010"
TELEGRAM_CHAT_ID = "-1003918216278"
MARKET_PAUSE_SEC = "1200"
RADIK_SESSION_DATE = "2026-11-13"

[userenv.production]
STARTUP_SAFETY_PAUSE_SEC = "0"
TELEGRAM_PUBLIC_BASE_URL = "https://lumpy-shimmering-element.replit.app"
